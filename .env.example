# Copy this file to .env for local development. Never commit .env or real credentials.
DATABASE_URL=sqlite:///./brandphantom.db
APP_NAME=BrandPhantom
APP_ENV=development
APP_SECRET_KEY=replace-with-a-unique-random-value-of-at-least-32-characters
LOG_LEVEL=INFO
SESSION_EXPIRY_HOURS=24
DEMO_MODE_ENABLED=true
LIVE_CONNECTORS_ENABLED=false

# Reserved for future live adapters; credentials do not enable collection today.
TWITTER_API_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
GOOGLE_PLAY_SERVICE_ACCOUNT=
APPLE_STORE_API_KEY=
